# Apenas desenvolvimento local; troque em produção.
POSTGRES_PASSWORD=local-development-only-change-me
DJANGO_SECRET_KEY=local-development-only-secret-key-change-before-production

# Integração com marketplace — só desenvolvimento. Em produção vão para .env.backend,
# modo 600, no servidor. O partner_key nunca sai do backend.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=http://localhost:8080/jalapao-store/callback
# SHOPEE_API_BASE=https://openplatform.shopee.com.br

# Mercado Livre: configurar somente no backend (não enviar ao Next/browser).
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:8080/jalapao-store/callback
# Ative se a aplicação no DevCenter usar PKCE.
ML_PKCE_ENABLED=0

# com quantos dias de antecedência o painel avisa que a autorização vai vencer
# MARKETPLACE_ALERT_DAYS=15
